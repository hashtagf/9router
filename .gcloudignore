# Keep Cloud Build's source context aligned with the Docker build context.
.gcloudignore
.git
**/.git
.vscode
**/.vscode
node_modules
.next
out
build
dist
coverage
data
logs
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
